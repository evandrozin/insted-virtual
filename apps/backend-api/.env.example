# ---------------------------------------------------------------------------
# Integracao com o ERP academico JACAD
# ---------------------------------------------------------------------------
# Deixe JACAD_MODO_MOCK=true para operar com o dataset sintetico (demo/dev).
# Para integrar de verdade: preencha URL + token e mude para false.
JACAD_MODO_MOCK=true
JACAD_BASE_URL=
JACAD_TOKEN=
# Intervalo de re-sincronizacao de matriculas e grade horaria (segundos)
JACAD_SYNC_INTERVAL_S=900

# ---------------------------------------------------------------------------
# Regras de presenca
# ---------------------------------------------------------------------------
# Minutos apos o inicio da aula em que a entrada ainda conta como PRESENTE
TOLERANCIA_ATRASO_MIN=15
# Quanto antes do inicio da aula a carteira ja fica reservada para o aluno
JANELA_CHEGADA_ANTECIPADA_MIN=45
# Abaixo dessa taxa (%) a sala entra em alerta de baixa presenca
LIMIAR_BAIXA_PRESENCA=60
# Sem passagem por este tempo (s), a catraca e marcada offline
CATRACA_TIMEOUT_S=900

# ---------------------------------------------------------------------------
# Tempo real
# ---------------------------------------------------------------------------
# Periodo do tick que reconcilia a grade e empurra o dashboard (segundos)
TICK_DASHBOARD_S=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Simulador de catracas (DESLIGUE EM PRODUCAO)
# ---------------------------------------------------------------------------
# Gera passagens plausiveis a partir da grade real: faltas, atrasos e evasao.
SIMULADOR_ATIVO=true
SIMULADOR_INTERVALO_MS=700

# Ancora o relogio da aplicacao em um horario letivo, para que a maquete
# sempre tenha aulas em andamento durante uma apresentacao. Vazio = hora real.
RELOGIO_DEMO=
# Acelera a passagem do tempo: 1 = tempo real, 30 = 1 minuto por segundo.
SIMULADOR_FATOR_TEMPO=1

# ---------------------------------------------------------------------------
# Estado compartilhado (varias instancias / serverless)
# ---------------------------------------------------------------------------
# Vazio  = estado em memoria, instancia unica (padrao, igual ao comportamento
#          anterior: mesma latencia, simulador e relogio de demo funcionando).
# Definido = presencas, campus, feed, alertas e serie vao para o Redis, e o
#          broadcast entre instancias passa pelo canal pub/sub. Obrigatorio na
#          Vercel e em qualquer deploy com mais de uma replica.
# Na Vercel, a integracao Redis do Marketplace ja injeta REDIS_URL (ou KV_URL).
REDIS_URL=

# Loops de fundo (reconciliacao a cada TICK_DASHBOARD_S e resync do JACAD).
# Em serverless nao ha processo entre requisicoes: deixe false e use o Vercel
# Cron apontando para /api/v1/cron/reconciliar. Detectado automaticamente
# pela variavel VERCEL, mas pode ser forcado aqui.
LOOP_INTERNO=true

# Protege os endpoints /api/v1/cron/*. O Vercel Cron envia este valor em
# "Authorization: Bearer <CRON_SECRET>". Vazio = endpoint aberto (so em dev).
CRON_SECRET=
