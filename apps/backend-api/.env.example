# ---------------------------------------------------------------------------
# Integracao com o ERP academico JACAD
# ---------------------------------------------------------------------------
# Deixe JACAD_MODO_MOCK=true para operar com o dataset sintetico (demo/dev).
# Para integrar de verdade: preencha URL + token e mude para false.
JACAD_MODO_MOCK=true
JACAD_BASE_URL=
JACAD_TOKEN=
# Intervalo de re-sincronizacao de matriculas e grade horaria (segundos)
JACAD_SYNC_INTERVAL_S=900

# ---------------------------------------------------------------------------
# Fuso do campus
# ---------------------------------------------------------------------------
# A grade horaria e hora de parede local ("aula das 19:00"). O servidor pode
# rodar em UTC (e roda, na Vercel), entao o fuso precisa ser explicito - sem
# isso o sistema procuraria aula 4 horas fora do lugar.
TIMEZONE=America/Campo_Grande

# ---------------------------------------------------------------------------
# Regras de presenca
# ---------------------------------------------------------------------------
# Minutos apos o inicio da aula em que a entrada ainda conta como PRESENTE
TOLERANCIA_ATRASO_MIN=15
# Quanto antes do inicio da aula a carteira ja fica reservada para o aluno
JANELA_CHEGADA_ANTECIPADA_MIN=45
# Abaixo dessa taxa (%) a sala entra em alerta de baixa presenca
LIMIAR_BAIXA_PRESENCA=60
# Sem passagem por este tempo (s), a catraca e marcada offline
CATRACA_TIMEOUT_S=900

# ---------------------------------------------------------------------------
# Tempo real
# ---------------------------------------------------------------------------
# Periodo do tick que reconcilia a grade e empurra o dashboard (segundos)
TICK_DASHBOARD_S=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Simulador de catracas (DESLIGUE EM PRODUCAO)
# ---------------------------------------------------------------------------
# Gera passagens plausiveis a partir da grade real: faltas, atrasos e evasao.
SIMULADOR_ATIVO=true
SIMULADOR_INTERVALO_MS=700

# Ancora o relogio da aplicacao em um horario letivo, para que a maquete
# sempre tenha aulas em andamento durante uma apresentacao. Vazio = hora real.
RELOGIO_DEMO=
# Acelera a passagem do tempo: 1 = tempo real, 30 = 1 minuto por segundo.
SIMULADOR_FATOR_TEMPO=1

# ---------------------------------------------------------------------------
# Estado compartilhado (varias instancias / serverless)
# ---------------------------------------------------------------------------
# Vazio  = estado em memoria, instancia unica (padrao, igual ao comportamento
#          anterior: mesma latencia, simulador e relogio de demo funcionando).
# Definido = presencas, campus, feed, alertas e serie vao para o Redis, e o
#          broadcast entre instancias passa pelo canal pub/sub. Obrigatorio na
#          Vercel e em qualquer deploy com mais de uma replica.
# Na Vercel, a integracao Redis do Marketplace ja injeta REDIS_URL (ou KV_URL).
REDIS_URL=

# Loops de fundo (reconciliacao a cada TICK_DASHBOARD_S e resync do JACAD).
# Em serverless nao ha processo entre requisicoes: deixe false e use o Vercel
# Cron apontando para /api/v1/cron/reconciliar. Detectado automaticamente
# pela variavel VERCEL, mas pode ser forcado aqui.
LOOP_INTERNO=true

# Protege os endpoints /api/v1/cron/*. O Vercel Cron envia este valor em
# "Authorization: Bearer <CRON_SECRET>". Vazio = endpoint aberto (so em dev).
CRON_SECRET=

# ---------------------------------------------------------------------------
# Cadastro de salas (Postgres)
# ---------------------------------------------------------------------------
# Vazio  = topologia vem do seed extraido das plantas Sigma (dev e fallback).
# Definido = predio / pavimento / sala saem do banco, e a Secretaria cadastra
#          sala nova sem precisar de deploy. O cadastro guarda tambem posicao e
#          dimensao, entao a sala aparece na maquete 3D.
# Se o banco estiver fora do ar no boot, o sistema cai no seed e segue de pe.
# No Supabase: Settings -> Database -> Connection string (URI).
DATABASE_URL=

# Qual predio carregar do cadastro.
PREDIO_CODIGO=SEDE

# ---------------------------------------------------------------------------
# Login (edicao do cadastro)
# ---------------------------------------------------------------------------
# Segredo de assinatura dos tokens de sessao. Minimo 32 caracteres.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vazio = login desligado e o cadastro fica somente-leitura.
JWT_SECRET=

# Validade da sessao, em horas.
SESSAO_HORAS=12

# ---------------------------------------------------------------------------
# Envio de e-mail (redefinicao de senha)
# ---------------------------------------------------------------------------
# Serve a um proposito so: entregar o codigo de 6 digitos que redefine a senha.
# Vazio = o recurso nao se anuncia. /auth/config devolve reset_por_email:false
# e o painel nao mostra "Esqueci minha senha", em vez de oferecer um caminho
# que morre na ultima tela.
#
# CAMINHO RECOMENDADO: Resend, por HTTPS na 443.
#
# O Render bloqueia saida nas portas SMTP (25, 465 e 587) nos servicos do plano
# free - la o SMTP falha com "Network is unreachable" antes de qualquer login,
# e nenhuma senha de app resolve. HTTPS nao e bloqueado em lugar nenhum.
#
# Chave em resend.com/api-keys. O dominio do remetente precisa estar verificado
# em resend.com/domains; sem verificar, o Resend so entrega no e-mail do dono
# da conta, o que serve para testar.
RESEND_API_KEY=

# Remetente, valido para os dois caminhos. Aceita "Nome <endereco>".
EMAIL_REMETENTE=

# --- Alternativa: SMTP -----------------------------------------------------
# Continua certo em host que nao bloqueie a porta: instancia paga do Render,
# container proprio, servidor da propria instituicao. Usado so quando
# RESEND_API_KEY esta vazia.
#
# Microsoft 365:  smtp.office365.com  porta 587 (exige SMTP AUTH liberado)
# Google Workspace: smtp.gmail.com    porta 587 (exige senha de app)
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=

# Remetente. Vazio = usa SMTP_USUARIO.
SMTP_REMETENTE=

# 587 negocia STARTTLS; 465 e TLS desde o inicio. Por padrao segue a porta.
SMTP_SSL=false

# Validade do codigo, em minutos. Tempo de abrir o e-mail e voltar, sem deixar
# um codigo de 6 digitos valido a tarde inteira.
RESET_VALIDADE_MIN=15

# Tentativas erradas antes de o codigo ser queimado. Um codigo de 6 digitos tem
# 1 milhao de combinacoes: sem teto, forca bruta acha em minutos.
RESET_MAX_TENTATIVAS=5

# Intervalo minimo entre pedidos para o mesmo e-mail, em segundos.
RESET_INTERVALO_S=60
