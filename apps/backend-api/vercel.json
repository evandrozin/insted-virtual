{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 800,
      "memory": 2048
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/v1/cron/reconciliar", "schedule": "* * * * *" },
    { "path": "/api/v1/cron/sync-jacad", "schedule": "0 * * * *" }
  ]
}
